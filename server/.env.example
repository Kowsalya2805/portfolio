# Server Port Configuration
PORT=5000

# Client Application URL (For CORS protection)
CLIENT_URL=http://localhost:3000

# Gmail SMTP Configuration for Nodemailer
# To obtain a 16-character Gmail App Password:
# 1. Go to your Google Account -> Security -> 2-Step Verification (Turn ON).
# 2. Search for "App passwords" in your Google Account search bar.
# 3. Select app: "Mail", device: "Other (Portfolio Website)".
# 4. Generate & copy the 16-character App Password (e.g., abcd efgh ijkl mnop).

GMAIL_USER=kowsalyasubbu289@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password_here

# Recipient Email (Where visitor messages will be sent)
RECIPIENT_EMAIL=kowsalyasubbu289@gmail.com
